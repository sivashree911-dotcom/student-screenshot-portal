{
  "name": "student-screenshot-portal-backend",
  "version": "1.0.0",
  "description": "Backend API for Student Screenshot Portal",
  "main": "server.js",
  "scripts": {
    "build": "node -e \"const fs = require('fs'), cp = require('child_process'); if (fs.existsSync('../frontend')) { cp.execSync('npm --prefix ../frontend install --include=dev && npm --prefix ../frontend run build', { stdio: 'inherit' }); }\"",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node scripts/testRegisterVerification.js",
    "test:verification": "node scripts/testRegisterVerification.js",
    "test:e2e": "node scripts/testEndToEnd.js",
    "init-db": "node scripts/initDb.js",
    "create-admin": "node scripts/createAdmin.js"
  },
  "keywords": [
    "student",
    "hackathon",
    "screenshot",
    "portal",
    "mysql",
    "express"
  ],
  "author": "College Portal Admin",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "mysql2": "^3.12.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
