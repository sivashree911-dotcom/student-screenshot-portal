# ==============================================================================
# STUDENT SCREENSHOT PORTAL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=student_screenshot_portal

# Security Secrets
JWT_SECRET=super_secret_jwt_key_portal_2026_change_in_production
JWT_EXPIRES_IN=7d

# Google Apps Script Web App API URL for Student Verification
# Paste your deployed Google Apps Script URL below or leave empty for local development catalog:
APPS_SCRIPT_API_URL=

# Upload Storage Directory
UPLOAD_DIR=uploads
