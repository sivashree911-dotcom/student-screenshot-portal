# ==============================================================================
# STUDENT SCREENSHOT PORTAL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# MySQL Database Configuration (Aiven MySQL / Persistent External Database)
DB_HOST=your-aiven-db-hostname.aivencloud.com
DB_PORT=your-aiven-port
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_SSL=true

# Security Secrets
JWT_SECRET=super_secret_jwt_key_portal_2026_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary Storage Configuration (Screenshots)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Apps Script Web App API URL for Student Verification
APPS_SCRIPT_API_URL=https://script.google.com/macros/s/AKfycbxDCLHECrwXsVgifoSH7f7g1erL7LeS1lFlnvuAoj0nniTm6z9q5ezZJRXMKmUOKtTa/exec

# Initial Administrator Credentials (Auto-created/updated on startup if provided)
ADMIN_NAME=Portal Administrator
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=your_strong_admin_password

# Upload Directory Path (for posters / local dev fallback)
UPLOAD_DIR=uploads
